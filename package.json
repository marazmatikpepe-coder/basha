{
  "name": "bashnya-pomnit",
  "productName": "Башня помнит",
  "version": "0.2.0",
  "description": "Мрачная 2D-игра",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bashnya.pomnit",
    "productName": "Башня помнит",
    "files": [
      "index.html",
      "main.js",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}